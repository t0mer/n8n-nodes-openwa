{
	"name": "OpenWA: AI agent WhatsApp assistant",
	"nodes": [
		{
			"parameters": {
				"session": {
					"__rl": true,
					"mode": "id",
					"value": "YOUR_SESSION_ID"
				},
				"events": ["message.received"],
				"options": {
					"chatType": "direct",
					"ignoreFromMe": true
				}
			},
			"id": "a194d385-66ac-4d86-bd7e-624cf3dd46e9",
			"name": "On WhatsApp Message",
			"type": "@t0mer/n8n-nodes-openwa.openWaMessageTrigger",
			"typeVersion": 1,
			"position": [0, 0],
			"webhookId": "84227eb6-9bdf-4f31-9c3c-ccf10a3bf1bb"
		},
		{
			"parameters": {
				"promptType": "define",
				"text": "={{ $json.data.body }}",
				"options": {
					"systemMessage": "You are a friendly customer support assistant that answers WhatsApp messages for Example Ltd.\n\n- Keep answers short: WhatsApp is read on a phone. Two or three sentences at most.\n- Use plain text. WhatsApp supports *bold* and _italic_, but no Markdown headings, tables or links in brackets.\n- If you don't know the answer, say so and offer to have a human call back.\n- Never ask for passwords, card numbers or other secrets."
				}
			},
			"id": "1a1916de-30ca-41d7-8316-8eb4bdf47e37",
			"name": "Support Agent",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 2.2,
			"position": [240, 0]
		},
		{
			"parameters": {
				"model": {
					"__rl": true,
					"mode": "list",
					"value": "gpt-4o-mini"
				},
				"options": {}
			},
			"id": "f911312b-8806-4374-922b-9219837215b3",
			"name": "OpenAI Chat Model",
			"type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
			"typeVersion": 1.2,
			"position": [140, 220]
		},
		{
			"parameters": {
				"sessionIdType": "customKey",
				"sessionKey": "={{ $('On WhatsApp Message').item.json.data.from }}",
				"contextWindowLength": 10
			},
			"id": "c047b0b0-4bb7-41b8-a991-762abf2fe5c1",
			"name": "Memory per Chat",
			"type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
			"typeVersion": 1.3,
			"position": [340, 220]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "sendText",
				"session": {
					"__rl": true,
					"mode": "id",
					"value": "YOUR_SESSION_ID"
				},
				"recipientType": "contact",
				"phoneNumber": "={{ $('On WhatsApp Message').item.json.data.from }}",
				"text": "={{ $json.output }}",
				"options": {}
			},
			"id": "316e477a-b39e-45c3-8a7b-e38416a9d4f4",
			"name": "Send Answer",
			"type": "@t0mer/n8n-nodes-openwa.openWa",
			"typeVersion": 1.1,
			"position": [600, 0]
		}
	],
	"connections": {
		"On WhatsApp Message": {
			"main": [
				[
					{
						"node": "Support Agent",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"OpenAI Chat Model": {
			"ai_languageModel": [
				[
					{
						"node": "Support Agent",
						"type": "ai_languageModel",
						"index": 0
					}
				]
			]
		},
		"Memory per Chat": {
			"ai_memory": [
				[
					{
						"node": "Support Agent",
						"type": "ai_memory",
						"index": 0
					}
				]
			]
		},
		"Support Agent": {
			"main": [
				[
					{
						"node": "Send Answer",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"pinData": {},
	"settings": {
		"executionOrder": "v1"
	}
}
